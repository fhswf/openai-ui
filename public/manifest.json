{
  "name": "K!mpuls Chatbot",
  "short_name": "K!mpuls",
  "description": "Use the K!mpuls Chatbot to acces OpenAI models securly.",
  "version": "0.54.0",
  "manifest_version": 3,
  "author": "Christian Gawron",
  "homepage_url": "https://openai.ki.fh-swf.de",
  "id": "/",
  "display": "standalone",
  "scope": "/",
  "start_url": "/",
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            ".pdf",
            ".doc",
            ".docx",
            ".pptx",
            ".css",
            ".c",
            ".cpp",
            ".cs",
            ".go",
            ".java",
            ".js",
            ".php",
            ".py",
            ".rb",
            ".sh",
            ".tex",
            ".ts",
            ".txt",
            ".md",
            ".html",
            ".json",
            ".xml",
            ".yaml",
            ".yml",
            ".csv",
            ".tsv",
            ".xlsx",
            ".xls",
            ".iif"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/logo200.png",
      "sizes": "200x200",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
