{
  "name": "K!mpuls Chatbot",
  "short_name": "K!mpuls",
  "description": "Use the K!mpuls Chatbot to acces OpenAI models securly.",
  "version": "0.54.0",
  "author": "Christian Gawron",
  "homepage_url": "https://openai.ki.fh-swf.de",
  "id": "/",
  "display": "standalone",
  "scope": "/",
  "start_url": "/",
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            ".pdf",
            ".doc",
            ".docx",
            ".pptx",
            ".css",
            ".c",
            ".cpp",
            ".cs",
            ".go",
            ".java",
            ".js",
            ".php",
            ".py",
            ".rb",
            ".sh",
            ".tex",
            ".ts",
            ".txt",
            ".md",
            ".html",
            ".json",
            ".xml",
            ".yaml",
            ".yml",
            ".csv",
            ".tsv",
            ".xlsx",
            ".xls",
            ".iif",
            "image/png",
            "image/jpeg",
            "image/gif",
            "image/webp",
            "image/svg+xml",
            "image/bmp",
            "image/tiff",
            "image/avif",
            "application/pdf",
            "application/msword",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/vnd.openxmlformats-officedocument.presentationml.presentation",
            "text/css",
            "text/x-csrc",
            "text/x-c++src",
            "text/plain",
            "text/x-go",
            "text/x-java-source",
            "text/javascript",
            "application/x-httpd-php",
            "text/x-python",
            "text/x-ruby",
            "application/x-sh",
            "application/x-tex",
            "application/typescript",
            "text/markdown",
            "text/html",
            "application/json",
            "application/xml",
            "application/yaml",
            "text/csv",
            "text/tab-separated-values",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "application/vnd.ms-excel"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/logo200.png",
      "sizes": "200x200",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
