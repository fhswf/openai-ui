{
  "name": "K!mpuls Chatbot",
  "short_name": "K!mpuls",
  "description": "Use the K!mpuls Chatbot to access OpenAI models securely.",
  "version": "0.60.0",
  "id": "/",
  "display": "standalone",
  "scope": "/",
  "start_url": "/",
  "theme_color": "#00519e",
  "background_color": "#ffffff",
  "screenshots": [
    {
      "src": "/pwa-screenshot-wide.png",
      "sizes": "1440x1000",
      "type": "image/png",
      "form_factor": "wide",
      "label": "K!mpuls chatbot on desktop"
    },
    {
      "src": "/pwa-screenshot-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "K!mpuls chatbot on mobile"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            ".pdf",
            ".doc",
            ".docx",
            ".pptx",
            ".txt",
            ".md",
            ".html",
            ".json",
            ".xml",
            ".yaml",
            ".yml",
            ".css",
            ".c",
            ".cpp",
            ".cs",
            ".go",
            ".java",
            ".js",
            ".php",
            ".py",
            ".rb",
            ".sh",
            ".tex",
            ".ts",
            ".xlsx",
            ".xls",
            ".csv",
            ".tsv",
            ".iif"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/logo192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/logo512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
